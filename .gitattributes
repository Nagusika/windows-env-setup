# Files consumed by Linux/WSL must keep LF endings regardless of the OS the repo
# is checked out on; a CRLF would make bash fail ("bad interpreter") or corrupt
# /etc/wsl.conf.
*.sh                 text eol=lf
config/wsl.conf      text eol=lf
config/wslconfig     text eol=lf
config/starship.toml text eol=lf
