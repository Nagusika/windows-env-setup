{
  "$schema": "./packages.schema.json",
  "description": "Declarative package list consumed by install.ps1. Lean by design: a usable Linux-like dev environment, not a kitchen sink. tier 'default' is prompted Yes; tier 'advanced' is prompted No and shows an IT-policy warning.",
  "categories": [
    {
      "name": "Shell & Terminal",
      "tier": "default",
      "packages": [
        { "id": "Microsoft.PowerShell", "name": "PowerShell 7" },
        { "id": "Microsoft.WindowsTerminal", "name": "Windows Terminal" },
        { "id": "Microsoft.PowerToys", "name": "PowerToys" },
        { "id": "VSCodium.VSCodium", "name": "VSCodium" },
        { "id": "M2Team.NanaZip", "name": "NanaZip" }
      ]
    },
    {
      "name": "CLI Toolbox (FOSS)",
      "tier": "default",
      "packages": [
        { "id": "BurntSushi.ripgrep.MSVC", "name": "ripgrep" },
        { "id": "sharkdp.fd", "name": "fd" },
        { "id": "junegunn.fzf", "name": "fzf" },
        { "id": "sharkdp.bat", "name": "bat" },
        { "id": "jqlang.jq", "name": "jq" },
        { "id": "eza-community.eza", "name": "eza" },
        { "id": "ajeetdsouza.zoxide", "name": "zoxide" },
        { "id": "Schniz.fnm", "name": "fnm (Node version manager)" },
        { "id": "Starship.Starship", "name": "Starship prompt" }
      ]
    },
    {
      "name": "Development",
      "tier": "default",
      "packages": [
        { "id": "Python.Python.3.13", "name": "Python 3.13" },
        { "id": "astral-sh.uv", "name": "uv (Python package manager)" },
        { "id": "GoLang.Go", "name": "Go" },
        { "id": "Rustlang.Rustup", "name": "Rust (rustup)" },
        { "id": "OpenJS.NodeJS", "name": "Node.js" }
      ]
    },
    {
      "name": "Security / Passwords",
      "tier": "default",
      "packages": [
        { "id": "KeePassXCTeam.KeePassXC", "name": "KeePassXC" },
        { "id": "Bitwarden.Bitwarden", "name": "Bitwarden" }
      ]
    },
    {
      "name": "Package Managers",
      "tier": "default",
      "packages": [
        { "id": "ScoopInstaller.Scoop", "name": "Scoop" }
      ]
    },
    {
      "name": "Advanced - may violate IT policy",
      "tier": "advanced",
      "packages": [
        { "id": "WiresharkFoundation.Wireshark", "name": "Wireshark (network sniffer)" },
        { "id": "Insecure.Nmap", "name": "Nmap (port scanner)" },
        { "id": "WinsiderSS.SystemInformer", "name": "System Informer (process inspector)" },
        { "id": "RustDesk.RustDesk", "name": "RustDesk (unmanaged remote access)" },
        { "id": "Rufus.Rufus", "name": "Rufus (bootable USB creator)" },
        { "id": "Ventoy.Ventoy", "name": "Ventoy (bootable USB creator)" },
        { "id": "VeraCrypt.VeraCrypt", "name": "VeraCrypt (encrypted containers)" },
        { "id": "SSHFS-Win.SSHFS-Win", "name": "SSHFS-Win (remote filesystem mount)" },
        { "id": "WinFsp.WinFsp", "name": "WinFsp (user-mode filesystem driver)" }
      ]
    }
  ]
}
